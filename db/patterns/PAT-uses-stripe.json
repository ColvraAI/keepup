{
  "version": "1",
  "id": "PAT-uses-stripe",
  "name": "The product uses Stripe",
  "find": [
    {
      "regex": "^\\s*(?:import stripe\\b|from stripe\\b|import .* from [\\\"']stripe[\\\"'])"
    },
    {
      "regex": "^\\s*\"(?:stripe|@stripe/[\\w.-]+)\"\\s*:\\s*\"(?:[\\^~<>=*\\d]|v\\d|(?:latest|next)\"|workspace:|catalog:|npm:)",
      "files": [
        "**/package.json"
      ],
      "note": "A dependency line in package.json: the name as a key, then a version, so a script of the same name stays quiet."
    },
    {
      "regex": "^\\s*(?:stripe)(?:\\[[^\\]]*\\])?\\s*(?:[=<>~!]=|[<>;@#]|$)",
      "flags": "i",
      "files": [
        "**/requirements*.txt"
      ],
      "note": "A dependency line in a requirements file. The whole name, so a look-alike package stays quiet."
    },
    {
      "regex": "^\\s*(?:[\\w-]+\\s*=\\s*\\[\\s*)?(?:[\"'][^\"']*[\"']\\s*,\\s*)*[\"'](?:stripe)(?:\\[[^\\]]*\\][\"']|(?:\\[[^\\]]*\\])?\\s*(?:[=<>~!]=|[<>;]))",
      "flags": "i",
      "files": [
        "**/pyproject.toml"
      ],
      "note": "A dependency in a pyproject.toml list. It needs a version or an extra, because a bare name could be a keyword."
    },
    {
      "regex": "^\\s*(?:stripe)\\s*=\\s*(?:[\"'][\\^~<>=!*\\d]|\\{)",
      "flags": "i",
      "files": [
        "**/pyproject.toml"
      ],
      "note": "A dependency in a pyproject.toml table, as Poetry writes it. Its value is a version or a table, so a script of the same name stays quiet."
    }
  ],
  "skip_if_near": [],
  "skip_if_in_file": [],
  "files": [
    "**/*.py",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/package.json",
    "**/requirements*.txt",
    "**/pyproject.toml"
  ],
  "skip_files": [
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/testdata/**",
    "**/fixtures/**",
    "**/examples/**",
    "**/samples/**",
    "**/docs/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/templates/**",
    "**/template/**",
    "**/*-templates/**",
    "**/starters/**"
  ],
  "why": "Stripe is in the code or in what the repo declares, so its own MCP server lets the team's coding agent read that service. It's a team tool and never a pull request.",
  "status": "live",
  "effect": [
    "new capability"
  ],
  "live_from": "v0.3"
}