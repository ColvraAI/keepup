{
  "version": "1",
  "id": "PAT-uses-github",
  "name": "The product uses GitHub",
  "find": [
    {
      "regex": "^\\s*(?:import .* from [\\\"']@octokit/|from github import\\b)"
    },
    {
      "regex": "^\\s*\"(?:octokit|@octokit/[\\w.-]+)\"\\s*:\\s*\"(?:[\\^~<>=*\\d]|v\\d|(?:latest|next)\"|workspace:|catalog:|npm:)",
      "files": [
        "**/package.json"
      ],
      "note": "A dependency line in package.json: the name as a key, then a version, so a script of the same name stays quiet."
    },
    {
      "regex": "^\\s*(?:pygithub)(?:\\[[^\\]]*\\])?\\s*(?:[=<>~!]=|[<>;@#]|$)",
      "flags": "i",
      "files": [
        "**/requirements*.txt"
      ],
      "note": "A dependency line in a requirements file. The whole name, so a look-alike package stays quiet."
    },
    {
      "regex": "^\\s*(?:[\\w-]+\\s*=\\s*\\[\\s*)?(?:[\"'][^\"']*[\"']\\s*,\\s*)*[\"'](?:pygithub)(?:\\[[^\\]]*\\][\"']|(?:\\[[^\\]]*\\])?\\s*(?:[=<>~!]=|[<>;]))",
      "flags": "i",
      "files": [
        "**/pyproject.toml"
      ],
      "note": "A dependency in a pyproject.toml list. It needs a version or an extra, because a bare name could be a keyword."
    },
    {
      "regex": "^\\s*(?:pygithub)\\s*=\\s*(?:[\"'][\\^~<>=!*\\d]|\\{)",
      "flags": "i",
      "files": [
        "**/pyproject.toml"
      ],
      "note": "A dependency in a pyproject.toml table, as Poetry writes it. Its value is a version or a table, so a script of the same name stays quiet."
    },
    {
      "regex": "^[\"']?on[\"']?\\s*:",
      "files": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "note": "A workflow's on: line. GitHub only runs the ones at the top of a repo, and one there means the team builds on GitHub."
    }
  ],
  "skip_if_near": [],
  "skip_if_in_file": [],
  "files": [
    "**/*.py",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/package.json",
    "**/requirements*.txt",
    "**/pyproject.toml",
    ".github/workflows/*.yml",
    ".github/workflows/*.yaml"
  ],
  "skip_files": [
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/testdata/**",
    "**/fixtures/**",
    "**/examples/**",
    "**/samples/**",
    "**/docs/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/templates/**",
    "**/template/**",
    "**/*-templates/**",
    "**/starters/**"
  ],
  "why": "GitHub is in the code or in what the repo declares, or the repo's workflows run there, so its own MCP server lets the team's coding agent read that service. It's a team tool and never a pull request.",
  "status": "live",
  "effect": [
    "new capability"
  ],
  "live_from": "v0.3"
}