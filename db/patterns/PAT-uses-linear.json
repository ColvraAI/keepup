{
  "version": "1",
  "id": "PAT-uses-linear",
  "name": "The product uses Linear",
  "find": [
    {
      "regex": "^\\s*import .* from [\\\"']@linear/sdk[\\\"']"
    },
    {
      "regex": "^\\s*\"(?:@linear/sdk)\"\\s*:\\s*\"(?:[\\^~<>=*\\d]|v\\d|(?:latest|next)\"|workspace:|catalog:|npm:)",
      "files": [
        "**/package.json"
      ],
      "note": "A dependency line in package.json: the name as a key, then a version, so a script of the same name stays quiet."
    }
  ],
  "skip_if_near": [],
  "skip_if_in_file": [],
  "files": [
    "**/*.py",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/package.json"
  ],
  "skip_files": [
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/testdata/**",
    "**/fixtures/**",
    "**/examples/**",
    "**/samples/**",
    "**/docs/**",
    "**/node_modules/**",
    "**/vendor/**",
    "**/dist/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/templates/**",
    "**/template/**",
    "**/*-templates/**",
    "**/starters/**"
  ],
  "why": "Linear is in the code or in what the repo declares, so its own MCP server lets the team's coding agent read that service. It's a team tool and never a pull request.",
  "status": "info",
  "effect": [
    "new capability"
  ],
  "live_from": "v0.3"
}