# Copy to .env (git ignores it). Never commit keys, never print them.

# The demo org. Create it at https://github.com/account/organizations/new, then run: npm run setup -- --org <name>
DEMO_ORG=
# Optional: orgs you own that setup must refuse as the demo org, comma-separated.
KEEPUP_NOT_DEMO_ORGS=

# Written by `npm run setup` after you click "Create GitHub App" and "Install".
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# The lab measures with these. Your credits, a few cents per run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only for the Claude-only variant of PR 01 (lab/01-router --variant jev).
TYPESAFE_API_KEY=
# Only for lab/04-mcp, a free Sentry account with a small demo project.
SENTRY_ACCESS_TOKEN=
SENTRY_HOST=sentry.io
# Only for lab/04-mcp's investigation against a local SigNoz (lab/04-mcp/testset/notes.md).
SIGNOZ_URL=
SIGNOZ_API_KEY=


# npm run deploy reads this: https://vercel.com/account/tokens
VERCEL_TOKEN=
