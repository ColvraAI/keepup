{
  "description": "The weekly check: one line at most once a week, when you open Claude Code in a repo.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/keepup",
            "args": [
              "check",
              "${CLAUDE_PROJECT_DIR}",
              "--weekly-state",
              "${CLAUDE_PLUGIN_DATA}/weekly-check.json",
              "--hook"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
