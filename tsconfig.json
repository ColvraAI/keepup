{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "module": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true
  },
  "include": ["app/**/*.ts", "lab/shared/**/*.ts", "src/**/*.ts", "bin/**/*.ts", "test/*.ts"]
}
