+const JEV_TIMEOUT_MS = 10_000;
+const NO_CATEGORY = "none";
+const JEV_INSTRUCTIONS = `Which category best matches the user's message? The categories are listed in priority order: pick the FIRST category whose description matches the message. If no category matches, pick "${NO_CATEGORY}".`;
+
 /**
  * Classify a user prompt against a batch of LLM rules using the router's
