+/* eslint-env jest */
+const mockAgentStart = jest.fn();
+
+jest.mock("../../../../../utils/agents/aibitat/index.js", () =>
+  jest.fn().mockImplementation(() => {
+    const aibitat = {
+      use: jest.fn(),
+      agent: jest.fn(),
+      start: () => mockAgentStart(aibitat),
+    };
+    return aibitat;
+  })
+);
+
+const {
+  classifyMessage,
+  classifyWithJev,
+  JEV_MIN_PROBABILITY,
+} = require("../../../../../utils/agents/aibitat/plugins/router-classifier");
+
+const CODING = { title: "coding", description: "Writing or fixing code." };
+const BILLING = { title: "billing", description: "Invoices and payments." };
+const RULES = [CODING, BILLING];
+const ROUTER = {
+  fallback_provider: "anthropic",
+  fallback_model: "claude-sonnet-4-6",
+};
+
+function jevResponse(choice, probability) {
+  return {
+    ok: true,
+    status: 200,
+    json: async () => ({
+      model: "jev-1.14.0",
+      answers: {
+        category: {
+          type: "choice",
+          choice,
+          confidence: probability,
+          probabilities: { [choice]: probability, other: 1 - probability },
+        },
+      },
+      usage: { input_tokens: 60, output_tokens: 12 },
+    }),
+  };
+}
+
+function agentAnswers(category) {
+  mockAgentStart.mockImplementation(async (aibitat) => {
+    aibitat.classifiedCategory = category;
+  });
+}
+
+describe("router classifier", () => {
+  const ORIGINAL_ENV = { ...process.env };
+  const ORIGINAL_FETCH = global.fetch;
+  let logSpy;
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    global.fetch = jest.fn();
+    process.env = {
+      ...ORIGINAL_ENV,
+      ROUTER_CLASSIFIER: "jev",
+      TYPESAFE_API_KEY: "test-key",
+    };
+    logSpy = jest.spyOn(console, "log").mockImplementation(() => {});
+    jest.spyOn(console, "error").mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    process.env = ORIGINAL_ENV;
+    global.fetch = ORIGINAL_FETCH;
+    jest.restoreAllMocks();
+  });
+
+  const logged = () => logSpy.mock.calls.map((call) => call.join(" ")).join();
+
+  describe("classifyWithJev", () => {
+    it("sends the message and the categories in priority order, plus none", async () => {
+      global.fetch.mockResolvedValue(jevResponse("coding", 0.95));
+      await classifyWithJev(RULES, "fix my code");
+
+      const [url, options] = global.fetch.mock.calls[0];
+      expect(url).toBe("https://api.typesafe.ai/v1/systemone");
+      expect(options.method).toBe("POST");
+      expect(options.headers.Authorization).toBe("Bearer test-key");
+      expect(options.signal).toBeDefined();
+
+      const body = JSON.parse(options.body);
+      expect(body.model).toBe("jev-1.14.0");
+      expect(body.state).toBe("fix my code");
+      expect(body.questions.category.type).toBe("choice");
+      expect(Object.keys(body.questions.category.criteria)).toEqual([
+        "coding",
+        "billing",
+        "none",
+      ]);
+      expect(body.questions.category.criteria.coding).toBe(CODING.description);
+    });
+
+    it("answers with the rule at or above the threshold", async () => {
+      global.fetch.mockResolvedValue(
+        jevResponse("billing", JEV_MIN_PROBABILITY)
+      );
+      await expect(
+        classifyWithJev(RULES, "where is my invoice")
+      ).resolves.toEqual({
+        answered: true,
+        rule: BILLING,
+        probability: JEV_MIN_PROBABILITY,
+      });
+    });
+
+    it("gates on the chosen option's probability, not on confidence", async () => {
+      const response = await jevResponse("billing", 0.65).json();
+      response.answers.category.confidence = 0.99;
+      global.fetch.mockResolvedValue({
+        ok: true,
+        status: 200,
+        json: async () => response,
+      });
+      const result = await classifyWithJev(RULES, "an invoice?");
+      expect(result.answered).toBe(false);
+    });
+
+    it("doesn't answer on an HTTP error", async () => {
+      global.fetch.mockResolvedValue({
+        ok: false,
+        status: 529,
+        text: async () => "overloaded",
+      });
+      const result = await classifyWithJev(RULES, "something");
+      expect(result).toEqual({
+        answered: false,
+        reason: expect.stringContaining("529"),
+      });
+    });
+
+    it("doesn't answer with a category it never offered", async () => {
+      global.fetch.mockResolvedValue(jevResponse("travel", 0.99));
+      const result = await classifyWithJev(RULES, "a flight");
+      expect(result.answered).toBe(false);
+    });
+
+    it("doesn't answer without a usable choice", async () => {
+      global.fetch.mockResolvedValue({
+        ok: true,
+        status: 200,
+        json: async () => ({ answers: {} }),
+      });
+      const result = await classifyWithJev(RULES, "something");
+      expect(result.answered).toBe(false);
+    });
+
+    it("skips rules with no description, as the agent path does", async () => {
+      global.fetch.mockResolvedValue(jevResponse("coding", 0.95));
+      await classifyWithJev(
+        [CODING, { title: "empty", description: null }],
+        "fix my code"
+      );
+      const body = JSON.parse(global.fetch.mock.calls[0][1].body);
+      expect(Object.keys(body.questions.category.criteria)).toEqual([
+        "coding",
+        "none",
+      ]);
+    });
+
+    it("keeps one none option when a rule is itself titled none", async () => {
+      global.fetch.mockResolvedValue(jevResponse("coding", 0.95));
+      await classifyWithJev(
+        [CODING, { title: "none", description: "A rule named none." }],
+        "fix my code"
+      );
+      const body = JSON.parse(global.fetch.mock.calls[0][1].body);
+      expect(body.questions.category.criteria.none).not.toBe(
+        "A rule named none."
+      );
+    });
+
+    it("doesn't call the API with nothing to classify", async () => {
+      const noRules = await classifyWithJev([], "hello");
+      const noPrompt = await classifyWithJev(RULES, "");
+      expect(noRules.answered).toBe(false);
+      expect(noPrompt.answered).toBe(false);
+      expect(global.fetch).not.toHaveBeenCalled();
+    });
+  });
+
+  describe("classifyMessage", () => {
+    it("uses the Jev category and never starts the agent", async () => {
+      global.fetch.mockResolvedValue(jevResponse("coding", 0.95));
+      await expect(
+        classifyMessage(RULES, "fix my code", ROUTER)
+      ).resolves.toEqual(CODING);
+      expect(mockAgentStart).not.toHaveBeenCalled();
+      expect(logged()).toContain("jev answered");
+    });
+
+    it("falls back to the agent on low confidence, and logs why", async () => {
+      global.fetch.mockResolvedValue(jevResponse("coding", 0.69));
+      agentAnswers("billing");
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+        BILLING
+      );
+      expect(mockAgentStart).toHaveBeenCalledTimes(1);
+      expect(logged()).toContain("agent answered");
+      expect(logged()).toContain("0.69");
+    });
+
+    it("falls back to the agent on an API error, and logs why", async () => {
+      global.fetch.mockRejectedValue(new Error("connection reset"));
+      agentAnswers("coding");
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+        CODING
+      );
+      expect(logged()).toContain("agent answered");
+      expect(logged()).toContain("connection reset");
+    });
+
+    it("doesn't say the agent answered when it failed", async () => {
+      global.fetch.mockResolvedValue(jevResponse("coding", 0.69));
+      mockAgentStart.mockRejectedValueOnce(new Error("provider down"));
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toBeNull();
+      expect(logged()).toContain("falling back to the agent");
+      expect(logged()).toContain("agent returned no rule");
+      expect(logged()).not.toContain("agent answered");
+    });
+
+    it("treats a confident none as final: no rule, and no agent call", async () => {
+      global.fetch.mockResolvedValue(jevResponse("none", 0.9));
+      await expect(
+        classifyMessage(RULES, "good morning", ROUTER)
+      ).resolves.toBeNull();
+      expect(mockAgentStart).not.toHaveBeenCalled();
+      expect(logged()).toContain("jev answered");
+    });
+
+    it("lets the agent decide when none is under the threshold", async () => {
+      global.fetch.mockResolvedValue(jevResponse("none", 0.4));
+      agentAnswers("coding");
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+        CODING
+      );
+      expect(mockAgentStart).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([[undefined], ["agent"], ["something-else"]])(
+      "never calls Jev when the setting is %s",
+      async (setting) => {
+        if (setting === undefined) delete process.env.ROUTER_CLASSIFIER;
+        else process.env.ROUTER_CLASSIFIER = setting;
+        agentAnswers("coding");
+
+        await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+          CODING
+        );
+        expect(global.fetch).not.toHaveBeenCalled();
+      }
+    );
+
+    it("uses today's path without an error when there is no TypeSafe key", async () => {
+      delete process.env.TYPESAFE_API_KEY;
+      agentAnswers("billing");
+
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+        BILLING
+      );
+      expect(global.fetch).not.toHaveBeenCalled();
+      expect(console.error).not.toHaveBeenCalled();
+      expect(logged()).toContain("agent answered");
+    });
+  });
+});
