+/**
+ * Build the request body. A list under the caching size goes in the question as
+ * plain choices with descriptions, where it can't be cached and doesn't need to
+ * be. A list at that size moves to a shared prefix in `input`, since content in
+ * `questions` is outside the reusable prefix.
+ *
+ * Both forms use explicit mode, so the user's message is never written to the
+ * cache at the write rate. By default the API adds a breakpoint at the end of
+ * `input`, which is that message. With no breakpoint of ours, explicit mode
+ * turns caching off for the request.
+ *
+ * `input_json` isn't used. The message is plain text, and JSON parts can't carry
+ * a cache breakpoint and are limited to 256 KiB where text parts aren't.
+ * @param {Array} validRules - The rules to offer as choices, in priority order
+ * @param {string} prompt - The user's message to classify
+ * @returns {Object} The request body for POST /v1/decisions
+ */
+function buildDecisionsRequest(validRules, prompt) {
+  const categoryList = validRules
+    .map((rule) => `- ${rule.title}: ${rule.description}`)
+    .join("\n");
+  const cacheable =
+    Buffer.byteLength(categoryList) >= DECISIONS_CACHE_MIN_BYTES;
+  const question = {
+    type: "choice",
+    name: DECISIONS_QUESTION_NAME,
+    instructions: DECISIONS_INSTRUCTIONS,
+    choices: [
+      ...validRules.map((rule) => ({
+        value: rule.title,
+        ...(cacheable ? {} : { description: rule.description }),
+      })),
+      {
+        value: NO_CATEGORY,
+        description: "No other category matches the message.",
+      },
+    ],
+  };
+  if (!cacheable)
+    return {
+      model: DECISIONS_MODEL,
+      input: prompt,
+      prompt_cache_options: { mode: "explicit" },
+      questions: [question],
+    };
+
+  return {
+    model: DECISIONS_MODEL,
+    input: [
+      {
+        role: "developer",
+        content: [
+          {
+            type: "input_text",
+            text: `Categories, in priority order:\n${categoryList}`,
+            prompt_cache_breakpoint: { mode: "explicit" },
+          },
+        ],
+      },
+      { role: "user", content: prompt },
+    ],
+    prompt_cache_options: { mode: "explicit" },
+    questions: [question],
+  };
+}
