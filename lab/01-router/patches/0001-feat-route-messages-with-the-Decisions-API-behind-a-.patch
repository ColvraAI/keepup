+/* eslint-env jest */
+const mockDecisionsPost = jest.fn();
+const mockAgentStart = jest.fn();
+
+jest.mock("openai", () => jest.fn(() => ({ post: mockDecisionsPost })));
+jest.mock("../../../../../utils/agents/aibitat/index.js", () =>
+  jest.fn().mockImplementation(() => {
+    const aibitat = {
+      use: jest.fn(),
+      agent: jest.fn(),
+      start: () => mockAgentStart(aibitat),
+    };
+    return aibitat;
+  })
+);
+
+const OpenAI = require("openai");
+const {
+  classifyMessage,
+  classifyWithDecisions,
+  DECISIONS_MIN_PROBABILITY,
+} = require("../../../../../utils/agents/aibitat/plugins/router-classifier");
+
+const CODING = { title: "coding", description: "Writing or fixing code." };
+const BILLING = { title: "billing", description: "Invoices and payments." };
+const RULES = [CODING, BILLING];
+const ROUTER = { fallback_provider: "openai", fallback_model: "gpt-5.6-luna" };
+
+function decisionAnswer(choice, probability) {
+  return {
+    answers: [
+      {
+        type: "choice",
+        name: "category",
+        choice,
+        probabilities: [
+          { value: choice, probability },
+          { value: "other", probability: 1 - probability },
+        ],
+        confidence: probability,
+      },
+    ],
+    usage: { input_tokens: 60, output_tokens: 0, total_tokens: 60 },
+  };
+}
+
+function agentAnswers(category) {
+  mockAgentStart.mockImplementation(async (aibitat) => {
+    aibitat.classifiedCategory = category;
+  });
+}
+
+describe("router classifier", () => {
+  const ORIGINAL_ENV = { ...process.env };
+  let logSpy;
+
+  beforeEach(() => {
+    jest.clearAllMocks();
+    process.env = {
+      ...ORIGINAL_ENV,
+      ROUTER_CLASSIFIER: "decisions",
+      OPEN_AI_KEY: "test-key",
+    };
+    logSpy = jest.spyOn(console, "log").mockImplementation(() => {});
+    jest.spyOn(console, "error").mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    process.env = ORIGINAL_ENV;
+    jest.restoreAllMocks();
+  });
+
+  const logged = () => logSpy.mock.calls.map((call) => call.join(" ")).join();
+
+  describe("classifyWithDecisions", () => {
+    it("sends the message and the categories in priority order, plus none", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("coding", 0.95));
+      await classifyWithDecisions(RULES, "fix my code");
+
+      const [path, { body }] = mockDecisionsPost.mock.calls[0];
+      expect(path).toBe("/decisions");
+      expect(body.model).toBe("gpt-6-luna");
+      expect(body.input).toBe("fix my code");
+      expect(body.questions).toHaveLength(1);
+      expect(body.questions[0].type).toBe("choice");
+      expect(body.questions[0].choices.map(({ value }) => value)).toEqual([
+        "coding",
+        "billing",
+        "none",
+      ]);
+      expect(body.questions[0].choices[0].description).toBe(CODING.description);
+    });
+
+    it("doesn't retry or wait long, since the agent is ready as a fallback", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("coding", 0.95));
+      await classifyWithDecisions(RULES, "fix my code");
+
+      const options = OpenAI.mock.calls[0][0];
+      expect(options.apiKey).toBe("test-key");
+      expect(options.maxRetries).toBe(0);
+      expect(options.timeout).toBeGreaterThan(0);
+    });
+
+    it("answers with the rule at or above the threshold", async () => {
+      mockDecisionsPost.mockResolvedValue(
+        decisionAnswer("billing", DECISIONS_MIN_PROBABILITY)
+      );
+      await expect(
+        classifyWithDecisions(RULES, "where is my invoice")
+      ).resolves.toEqual({
+        answered: true,
+        rule: BILLING,
+        probability: DECISIONS_MIN_PROBABILITY,
+      });
+    });
+
+    it("gates on the chosen option's probability, not on confidence", async () => {
+      const response = decisionAnswer("billing", 0.65);
+      response.answers[0].confidence = 0.99;
+      mockDecisionsPost.mockResolvedValue(response);
+      const result = await classifyWithDecisions(RULES, "an invoice?");
+      expect(result.answered).toBe(false);
+    });
+
+    it("doesn't answer on a refusal", async () => {
+      mockDecisionsPost.mockResolvedValue({
+        answers: [{ type: "refusal", name: "category" }],
+      });
+      const result = await classifyWithDecisions(RULES, "something");
+      expect(result).toEqual({
+        answered: false,
+        reason: expect.stringContaining("refusal"),
+      });
+    });
+
+    it("doesn't answer with a category it never offered", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("travel", 0.99));
+      const result = await classifyWithDecisions(RULES, "a flight");
+      expect(result.answered).toBe(false);
+    });
+
+    it("doesn't answer without a probability for the chosen option", async () => {
+      mockDecisionsPost.mockResolvedValue({
+        answers: [{ type: "choice", choice: "coding", probabilities: [] }],
+      });
+      const result = await classifyWithDecisions(RULES, "some code");
+      expect(result.answered).toBe(false);
+    });
+
+    it("skips rules with no description, as the agent path does", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("coding", 0.95));
+      await classifyWithDecisions(
+        [CODING, { title: "empty", description: null }],
+        "fix my code"
+      );
+      const { body } = mockDecisionsPost.mock.calls[0][1];
+      expect(body.questions[0].choices.map(({ value }) => value)).toEqual([
+        "coding",
+        "none",
+      ]);
+    });
+
+    it("keeps choices unique when a rule is itself titled none", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("coding", 0.95));
+      await classifyWithDecisions(
+        [CODING, { title: "none", description: "A rule named none." }],
+        "fix my code"
+      );
+      const { body } = mockDecisionsPost.mock.calls[0][1];
+      expect(body.questions[0].choices.map(({ value }) => value)).toEqual([
+        "coding",
+        "none",
+      ]);
+    });
+
+    it("doesn't call the API with nothing to classify", async () => {
+      const noRules = await classifyWithDecisions([], "hello");
+      const noPrompt = await classifyWithDecisions(RULES, "");
+      expect(noRules.answered).toBe(false);
+      expect(noPrompt.answered).toBe(false);
+      expect(mockDecisionsPost).not.toHaveBeenCalled();
+    });
+  });
+
+  describe("classifyMessage", () => {
+    it("uses the Decisions category and never starts the agent", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("coding", 0.95));
+      await expect(
+        classifyMessage(RULES, "fix my code", ROUTER)
+      ).resolves.toEqual(CODING);
+      expect(mockAgentStart).not.toHaveBeenCalled();
+      expect(logged()).toContain("decisions answered");
+    });
+
+    it("falls back to the agent on low confidence, and logs why", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("coding", 0.69));
+      agentAnswers("billing");
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+        BILLING
+      );
+      expect(mockAgentStart).toHaveBeenCalledTimes(1);
+      expect(logged()).toContain("agent answered");
+      expect(logged()).toContain("0.69");
+    });
+
+    it("falls back to the agent on an API error, and logs why", async () => {
+      mockDecisionsPost.mockRejectedValue(new Error("503 overloaded"));
+      agentAnswers("coding");
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+        CODING
+      );
+      expect(logged()).toContain("agent answered");
+      expect(logged()).toContain("503 overloaded");
+    });
+
+    it("doesn't say the agent answered when it failed", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("coding", 0.69));
+      mockAgentStart.mockRejectedValueOnce(new Error("provider down"));
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toBeNull();
+      expect(logged()).toContain("falling back to the agent");
+      expect(logged()).toContain("agent returned no rule");
+      expect(logged()).not.toContain("agent answered");
+    });
+
+    it("treats a confident none as final: no rule, and no agent call", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("none", 0.9));
+      await expect(
+        classifyMessage(RULES, "good morning", ROUTER)
+      ).resolves.toBeNull();
+      expect(mockAgentStart).not.toHaveBeenCalled();
+      expect(logged()).toContain("decisions answered");
+    });
+
+    it("lets the agent decide when none is under the threshold", async () => {
+      mockDecisionsPost.mockResolvedValue(decisionAnswer("none", 0.4));
+      agentAnswers("coding");
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+        CODING
+      );
+      expect(mockAgentStart).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([[undefined], ["agent"], ["something-else"]])(
+      "never calls Decisions when the setting is %s",
+      async (setting) => {
+        if (setting === undefined) delete process.env.ROUTER_CLASSIFIER;
+        else process.env.ROUTER_CLASSIFIER = setting;
+        agentAnswers("coding");
+
+        await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+          CODING
+        );
+        expect(OpenAI).not.toHaveBeenCalled();
+        expect(mockDecisionsPost).not.toHaveBeenCalled();
+      }
+    );
+
+    it("uses today's path without an error when there is no OpenAI key", async () => {
+      delete process.env.OPEN_AI_KEY;
+      agentAnswers("billing");
+
+      await expect(classifyMessage(RULES, "hmm", ROUTER)).resolves.toEqual(
+        BILLING
+      );
+      expect(OpenAI).not.toHaveBeenCalled();
+      expect(console.error).not.toHaveBeenCalled();
+      expect(logged()).toContain("agent answered");
+    });
+
+    it("returns no rule when both paths have nothing to classify", async () => {
+      await expect(classifyMessage([], "hello", ROUTER)).resolves.toBeNull();
+      expect(mockAgentStart).not.toHaveBeenCalled();
+      expect(mockDecisionsPost).not.toHaveBeenCalled();
+    });
+  });
+});
