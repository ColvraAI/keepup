+const DECISIONS_MODEL = "gpt-6-luna";
+const DECISIONS_QUESTION_NAME = "category";
+// Below this probability a Decisions answer isn't trusted and the agent decides.
+const DECISIONS_MIN_PROBABILITY = 0.7;
+// The agent is ready as a fallback, so a slow call shouldn't hold up the message.
+const DECISIONS_TIMEOUT_MS = 10_000;
+const NO_CATEGORY = "none";
+const DECISIONS_INSTRUCTIONS = `Which category best matches the user's message? The categories are listed in priority order: pick the FIRST category whose description matches the message. If no category matches, pick "${NO_CATEGORY}".`;
+
 /**
  * Classify a user prompt against a batch of LLM rules using the router's
  * fallback provider/model. Runs a headless AIbitat instance with a single
@@ -119,4 +129,135 @@ async function classifyWithLLM(rules, prompt, router) {
   }
 }
 
-module.exports = { routerClassifier, classifyWithLLM };
+/**
+ * Classify a user prompt with the OpenAI Decisions API. This doesn't fall back
+ * by itself: `classifyMessage()` runs the agent when `answered` is false.
+ *
+ * "none" is a real answer: at or above the threshold it's final and means no
+ * rule matched, so we don't pay for the agent to repeat it. Under the threshold
+ * it's treated like any other unsure answer, because a weak "none" can hide a
+ * rule that should have matched, and the agent gets to decide.
+ * @param {Array} rules - Contiguous batch of enabled LLM-type rules (priority-sorted)
+ * @param {string} prompt - The user's message to classify
+ * @returns {Promise<{answered: true, rule: Object|null, probability: number}|{answered: false, reason: string}>}
+ */
+async function classifyWithDecisions(rules, prompt) {
+  // A rule titled "none" can't match on the agent path either, and the API
+  // rejects duplicate choices.
+  const validRules = rules.filter(
+    (rule) => rule.description && rule.title.toLowerCase() !== NO_CATEGORY
+  );
+  if (!validRules.length || !prompt)
+    return { answered: false, reason: "nothing to classify" };
+
+  try {
+    const client = new OpenAI({
+      apiKey: process.env.OPEN_AI_KEY,
+      timeout: DECISIONS_TIMEOUT_MS,
+      maxRetries: 0,
+    });
+    // The pinned SDK has no decisions resource, so call the endpoint directly.
+    const response = await client.post("/decisions", {
+      body: {
+        model: DECISIONS_MODEL,
+        input: prompt,
+        questions: [
+          {
+            type: "choice",
+            name: DECISIONS_QUESTION_NAME,
+            instructions: DECISIONS_INSTRUCTIONS,
+            choices: [
+              ...validRules.map((rule) => ({
+                value: rule.title,
+                description: rule.description,
+              })),
+              {
+                value: NO_CATEGORY,
+                description: "No other category matches the message.",
+              },
+            ],
+          },
+        ],
+      },
+    });
+    return readDecision(response?.answers?.[0], validRules);
+  } catch (error) {
+    return { answered: false, reason: error.message };
+  }
+}
+
+/**
+ * Turn a Decisions answer into a rule. The threshold is on the chosen option's
+ * probability, which reads directly as how likely that option is. The answer's
+ * separate `confidence` field isn't used.
+ * @param {Object} answer - One entry of the response's `answers`
+ * @param {Array} validRules - The rules that were offered as choices
+ * @returns {{answered: true, rule: Object|null, probability: number}|{answered: false, reason: string}}
+ */
+function readDecision(answer, validRules) {
+  if (answer?.type !== "choice")
+    return { answered: false, reason: `answer type was ${answer?.type}` };
+
+  const { choice, probabilities } = answer;
+  const probability = probabilities?.find(
+    (option) => option.value === choice
+  )?.probability;
+  if (typeof probability !== "number")
+    return { answered: false, reason: `no probability for "${choice}"` };
+  if (probability < DECISIONS_MIN_PROBABILITY)
+    return {
+      answered: false,
+      reason: `"${choice}" at ${probability} is under ${DECISIONS_MIN_PROBABILITY}`,
+    };
+  if (choice === NO_CATEGORY)
+    return { answered: true, rule: null, probability };
+
+  const rule = validRules.find((rule) => rule.title === choice);
+  if (!rule) return { answered: false, reason: `unknown category "${choice}"` };
+  return { answered: true, rule, probability };
+}
+
+/**
+ * Classify a user prompt on the path the ROUTER_CLASSIFIER setting asks for.
+ * The default is "agent", which is `classifyWithLLM()` alone. With "decisions"
+ * the Decisions API goes first and `classifyWithLLM()` is the fallback.
+ * @param {Array} rules - Contiguous batch of enabled LLM-type rules (priority-sorted)
+ * @param {string} prompt - The user's message to classify
+ * @param {Object} router - The router record (needs fallback_provider/fallback_model)
+ * @returns {Promise<Object|null>} The matched rule, or null if none matched
+ */
+async function classifyMessage(rules, prompt, router) {
+  if (process.env.ROUTER_CLASSIFIER !== "decisions")
+    return await classifyWithLLM(rules, prompt, router);
+
+  const decision = process.env.OPEN_AI_KEY
+    ? await classifyWithDecisions(rules, prompt)
+    : { answered: false, reason: "no OPEN_AI_KEY set" };
+
+  if (decision.answered) {
+    console.log(
+      `[RouterClassifier] decisions answered "${decision.rule?.title ?? NO_CATEGORY}" at ${decision.probability}`
+    );
+    return decision.rule;
+  }
+
+  console.log(
+    `[RouterClassifier] falling back to the agent: ${decision.reason}`
+  );
+  const matched = await classifyWithLLM(rules, prompt, router);
+  // Null means no rule matched or the agent failed, which it logs itself.
+  console.log(
+    matched
+      ? `[RouterClassifier] agent answered "${matched.title}"`
+      : "[RouterClassifier] agent returned no rule"
+  );
+  return matched;
+}
+
+module.exports = {
+  routerClassifier,
+  classifyWithLLM,
+  classifyWithDecisions,
+  classifyMessage,
+  DECISIONS_MIN_PROBABILITY,
+};
