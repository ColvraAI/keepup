+# Incident response agent — PagerDuty + SigNoz.
+# Triages alerts, then correlates metrics, traces, and logs from SigNoz.
+#
+# The SigNoz MCP server runs from its Docker image over stdio, so it works with
+# a self-hosted SigNoz and needs no hosted service.
+#
+# Prerequisites:
+#   1. Docker. Pull the image ahead of time so the first request doesn't spend
+#      its connect timeout on it: docker pull signoz/signoz-mcp-server:v0.17.0
+#   2. The variables below. SIGNOZ_URL is read from inside the container, so a
+#      SigNoz on this host is http://host.docker.internal:8080 on Docker Desktop.
+#        export OPENAI_API_KEY="sk-..."
+#        export PAGERDUTY_API_TOKEN="..."
+#        export SIGNOZ_URL="https://your-signoz-instance.com"
+#        export SIGNOZ_API_KEY="..."   # a SigNoz API key, which only an Admin can create
+#
+# Usage:
+#   CONFIG_PATH=examples/complete/incident-response-signoz.toml cargo run --bin aura -- webserver
+
+[mcp]
+sanitize_schemas = true
+
+# PagerDuty — incident and on-call management
+[mcp.servers.pagerduty]
+transport = "http_streamable"
+url = "https://mcp.pagerduty.com/mcp"
+description = "PagerDuty incident management, on-call schedules, and escalation"
+
+[mcp.servers.pagerduty.headers]
+Authorization = "Token {{ env.PAGERDUTY_API_TOKEN | default: '' }}"
+
+# SigNoz — metrics, traces, logs, alerts, and dashboards
+# `docker run -e NAME` copies the variable from `env` into the container, so the
+# API key never appears on a command line.
+[mcp.servers.signoz]
+transport = "stdio"
+cmd = ["docker"]
+args = ["run", "-i", "--rm", "-e", "SIGNOZ_URL", "-e", "SIGNOZ_API_KEY", "signoz/signoz-mcp-server:v0.17.0"]
+env = { SIGNOZ_URL = "{{ env.SIGNOZ_URL | default: '' }}", SIGNOZ_API_KEY = "{{ env.SIGNOZ_API_KEY | default: '' }}" }
+description = "SigNoz metrics, traces, logs, alerts, and dashboards"
+
+[agent]
+name = "Incident Response Agent"
+alias = "incident-response/signoz"
+description = "Incident triage with PagerDuty context and SigNoz telemetry"
+model_owner = "mezmo"
+system_prompt = """
+You are an incident response agent with access to PagerDuty and
+SigNoz. Follow this triage workflow:
+
+1. Identify the triggering alert and affected services via PagerDuty.
+2. Check alerts and service health in SigNoz, then correlate metrics, traces,
+   and logs for the affected services.
+3. Summarize findings: timeline, root cause hypothesis, and next steps.
+
+Always include timestamps and link back to source data.
+"""
+turn_depth = 10
+# SigNoz's read tools only. Triage changes nothing in SigNoz, and the write tools
+# carry most of the definition size sent to the model on every turn.
+mcp_filter = [
+  "pagerduty:*",
+  "signoz:signoz_{aggregate,check,execute,fetch,list,query,search}_*",
+  # Every get tool but get_notification_channel, whose settings can hold webhook URLs.
+  "signoz:signoz_get_[!n]*",
+]
+
+[agent.llm]
+provider = "openai"
+api_key = "{{ env.OPENAI_API_KEY }}"
+model = "gpt-5.2"
