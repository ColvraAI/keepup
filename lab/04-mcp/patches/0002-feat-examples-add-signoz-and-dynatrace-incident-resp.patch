+# Incident response agent — PagerDuty + Dynatrace Managed.
+# Triages alerts, then pulls problems, logs, events, and metrics from Dynatrace.
+#
+# This server is for self-hosted Dynatrace Managed clusters. Dynatrace SaaS has
+# its own server: https://github.com/dynatrace-oss/dynatrace-mcp
+#
+# Prerequisites:
+#   1. Node.js 26 (26.12.1 or later), as the package's engines field requires. `npx -y`
+#      downloads the server from the npm registry on first run, which has to finish
+#      within [mcp].connect_timeout_secs. To avoid that, or on an air-gapped host,
+#      install it ahead of time
+#      (npm install -g @dynatrace-oss/dynatrace-managed-mcp-server@2.0.0) and
+#      change `cmd` below to ["mcp-server-dynatrace"] with no `args`.
+#   2. A Dynatrace API token with these scopes: DataExport, entities.read,
+#      events.read, logs.read, metrics.read, problems.read,
+#      securityProblems.read, slo.read
+#   3. The variables below. apiEndpointUrl is the cluster's base URL.
+#        export OPENAI_API_KEY="sk-..."
+#        export PAGERDUTY_API_TOKEN="..."
+#        export DT_ENVIRONMENT_CONFIGS='[{"apiEndpointUrl":"https://your-cluster.example.com/","environmentId":"...","alias":"production","apiToken":"..."}]'
+#
+# Usage:
+#   CONFIG_PATH=examples/complete/incident-response-dynatrace-managed.toml cargo run --bin aura -- webserver
+
+[mcp]
+sanitize_schemas = true
+
+# PagerDuty — incident and on-call management
+[mcp.servers.pagerduty]
+transport = "http_streamable"
+url = "https://mcp.pagerduty.com/mcp"
+description = "PagerDuty incident management, on-call schedules, and escalation"
+
+[mcp.servers.pagerduty.headers]
+Authorization = "Token {{ env.PAGERDUTY_API_TOKEN | default: '' }}"
+
+# Dynatrace Managed — problems, logs, events, and metrics
+# The child process inherits AURA's environment, so DT_ENVIRONMENT_CONFIGS and the
+# token inside it stay out of this file. stderr-all keeps the server's log out of
+# the working directory.
+[mcp.servers.dynatrace_managed]
+transport = "stdio"
+cmd = ["npx"]
+args = ["-y", "@dynatrace-oss/dynatrace-managed-mcp-server@2.0.0"]
+env = { LOG_OUTPUT = "stderr-all" }
+description = "Dynatrace Managed problems, logs, events, metrics, entities, and SLOs"
+
+[agent]
+name = "Incident Response Agent"
+alias = "incident-response/dynatrace-managed"
+description = "Incident triage with PagerDuty context and Dynatrace Managed observability"
+model_owner = "mezmo"
+system_prompt = """
+You are an incident response agent with access to PagerDuty and
+Dynatrace Managed. Follow this triage workflow:
+
+1. Identify the triggering alert and affected services via PagerDuty.
+2. Pull the related problems, logs, events, and metrics from Dynatrace Managed.
+3. Summarize findings: timeline, root cause hypothesis, and next steps.
+
+Always include timestamps and link back to source data.
+"""
+turn_depth = 10
+
+[agent.llm]
+provider = "openai"
+api_key = "{{ env.OPENAI_API_KEY }}"
+model = "gpt-5.2"
