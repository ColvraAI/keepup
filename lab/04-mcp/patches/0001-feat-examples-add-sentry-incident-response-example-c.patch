+# Incident response agent — PagerDuty + Sentry.
+# Triages alerts, searches errors, and follows them to stack traces and releases.
+#
+# Prerequisites:
+#   export OPENAI_API_KEY="sk-..."
+#   export PAGERDUTY_API_TOKEN="..."
+#   export SENTRY_ACCESS_TOKEN="..."   # user auth token: org:read, project:read, team:read, event:read
+#
+# Usage:
+#   CONFIG_PATH=examples/complete/incident-response-sentry.toml cargo run --bin aura -- webserver
+
+[mcp]
+sanitize_schemas = true
+
+# PagerDuty — incident and on-call management
+[mcp.servers.pagerduty]
+transport = "http_streamable"
+url = "https://mcp.pagerduty.com/mcp"
+description = "PagerDuty incident management, on-call schedules, and escalation"
+
+[mcp.servers.pagerduty.headers]
+Authorization = "Token {{ env.PAGERDUTY_API_TOKEN | default: '' }}"
+
+# Sentry — errors, stack traces, and releases
+# Sentry's hosted server. skills=inspect leaves out the tools that update issues;
+# add triage to let the agent update them.
+[mcp.servers.sentry]
+transport = "http_streamable"
+url = "https://mcp.sentry.dev/mcp?skills=inspect"
+description = "Sentry issues, errors, stack traces, events, and releases"
+
+# Sentry-Bearer carries a Sentry API token; Bearer is reserved for MCP OAuth.
+[mcp.servers.sentry.headers]
+Authorization = "Sentry-Bearer {{ env.SENTRY_ACCESS_TOKEN | default: '' }}"
+
+[agent]
+name = "Incident Response Agent"
+alias = "incident-response/sentry"
+description = "Incident triage with PagerDuty context and Sentry error analysis"
+model_owner = "mezmo"
+system_prompt = """
+You are an incident response agent with access to PagerDuty and
+Sentry. Follow this triage workflow:
+
+1. Identify the triggering alert and affected services via PagerDuty.
+2. Search Sentry for the matching issues and errors, then read their stack
+   traces and events.
+3. Find the release that introduced the problem.
+4. Summarize findings: timeline, root cause hypothesis, and next steps.
+
+Always include timestamps and link back to source data.
+"""
+turn_depth = 10
+
+[agent.llm]
+provider = "openai"
+api_key = "{{ env.OPENAI_API_KEY }}"
+model = "gpt-5.2"
