+/* eslint-env jest */
+jest.mock("../../../utils/vectorStore/resetAllVectorStores", () => ({
+  resetAllVectorStores: jest.fn(async () => true),
+}));
+
+const {
+  resetAllVectorStores,
+} = require("../../../utils/vectorStore/resetAllVectorStores");
+const { NativeEmbedder } = require("../../../utils/EmbeddingEngines/native");
+const { updateENV } = require("../../../utils/helpers/updateENV");
+
+const EMBEDDING_GEMMA_2 = "onnx-community/embeddinggemma-2-ONNX";
+
+describe("updateENV EmbeddingModelPref", () => {
+  const ORIGINAL_ENV = process.env;
+
+  beforeEach(() => {
+    process.env = {
+      ...ORIGINAL_ENV,
+      EMBEDDING_ENGINE: "native",
+      EMBEDDING_MODEL_PREF: NativeEmbedder.defaultModel,
+    };
+    jest.spyOn(console, "log").mockImplementation(() => {});
+    jest.spyOn(console, "error").mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    process.env = ORIGINAL_ENV;
+    jest.restoreAllMocks();
+  });
+
+  it("logs a failed background download instead of leaving it unhandled", async () => {
+    const download = jest
+      .spyOn(NativeEmbedder.prototype, "embedderClient")
+      .mockRejectedValue(new Error("fetch failed"));
+
+    const { error } = await updateENV({ EmbeddingModelPref: EMBEDDING_GEMMA_2 });
+    await new Promise(setImmediate);
+
+    expect(error).toBe(false);
+    expect(resetAllVectorStores).toHaveBeenCalled();
+    expect(download).toHaveBeenCalledTimes(1);
+    expect(console.error).toHaveBeenCalledWith(
+      expect.stringContaining(EMBEDDING_GEMMA_2)
+    );
+    expect(console.error).toHaveBeenCalledWith(
+      expect.stringContaining("fetch failed")
+    );
+  });
+});
