+/* eslint-env jest */
+const fs = require("fs");
+const os = require("os");
+const path = require("path");
+const {
+  SUPPORTED_NATIVE_EMBEDDING_MODELS,
+} = require("../../../../utils/EmbeddingEngines/native/constants");
+
+const DEFAULT_MODEL = "Xenova/all-MiniLM-L6-v2";
+
+// A tiny stand-in for the feature-extraction pipeline, so CI never downloads a model.
+function fakeTransformers(dimension) {
+  const extractor = jest.fn(async (chunk) => ({
+    length: chunk.length,
+    tolist: () => chunk.map(() => new Array(dimension).fill(0.5)),
+  }));
+  return {
+    extractor,
+    transformers: {
+      env: { remoteHost: "https://huggingface.co/" },
+      pipeline: jest.fn(async () => extractor),
+    },
+  };
+}
+
+describe("NativeEmbedder", () => {
+  const ORIGINAL_ENV = process.env;
+  let NativeEmbedder;
+  let storageDir;
+
+  function loadWith(fake) {
+    return jest
+      .spyOn(NativeEmbedder, "_loadTransformers")
+      .mockResolvedValue(fake.transformers);
+  }
+
+  beforeEach(() => {
+    // Pipelines are kept per model on the class, so each test needs a fresh one.
+    jest.resetModules();
+    ({ NativeEmbedder } = require("../../../../utils/EmbeddingEngines/native"));
+    storageDir = fs.mkdtempSync(path.join(os.tmpdir(), "native-embedder-"));
+    process.env = { ...ORIGINAL_ENV, STORAGE_DIR: storageDir };
+    delete process.env.EMBEDDING_MODEL_PREF;
+    jest.spyOn(console, "log").mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    process.env = ORIGINAL_ENV;
+    jest.restoreAllMocks();
+    fs.rmSync(storageDir, { recursive: true, force: true });
+  });
+
+  it("keeps all-MiniLM-L6-v2 as the default model", () => {
+    expect(NativeEmbedder.defaultModel).toBe(DEFAULT_MODEL);
+    expect(new NativeEmbedder().model).toBe(DEFAULT_MODEL);
+  });
+
+  it.each(Object.keys(SUPPORTED_NATIVE_EMBEDDING_MODELS))(
+    "%s has a well-formed entry",
+    (id) => {
+      const entry = SUPPORTED_NATIVE_EMBEDDING_MODELS[id];
+      expect(entry.maxConcurrentChunks).toBeGreaterThan(0);
+      expect(entry.embeddingMaxChunkLength).toBeGreaterThan(0);
+      expect(typeof entry.chunkPrefix).toBe("string");
+      expect(typeof entry.queryPrefix).toBe("string");
+      expect(entry.dtype).toEqual(expect.any(String));
+      expect(entry.apiInfo.id).toBe(id);
+      for (const field of ["name", "description", "lang", "size"])
+        expect(entry.apiInfo[field]).toEqual(expect.any(String));
+      expect(entry.apiInfo.modelCard).toMatch(/^https:\/\/huggingface\.co\//);
+    }
+  );
+
+  it("lists every supported model for the embedder picker", () => {
+    expect(NativeEmbedder.availableModels().map((m) => m.id)).toEqual(
+      Object.keys(NativeEmbedder.supportedModels)
+    );
+  });
+
+  it("loads the same quantized weights as before the package change", async () => {
+    const fake = fakeTransformers(384);
+    loadWith(fake);
+    process.env.EMBEDDING_MODEL_PREF = DEFAULT_MODEL;
+
+    const vector = await new NativeEmbedder().embedTextInput("hello");
+
+    const [task, model, options] = fake.transformers.pipeline.mock.calls[0];
+    expect(task).toBe("feature-extraction");
+    expect(model).toBe(DEFAULT_MODEL);
+    expect(options.dtype).toBe("q8");
+    expect(options.cache_dir).toBe(path.resolve(storageDir, "models"));
+    expect(options.config).toBeUndefined();
+    expect(vector).toHaveLength(384);
+  });
+
+  it("looks for model files in our cache, so a downloaded model loads with no network", async () => {
+    const fake = fakeTransformers(384);
+    loadWith(fake);
+    process.env.EMBEDDING_MODEL_PREF = DEFAULT_MODEL;
+
+    await new NativeEmbedder().embedderClient();
+
+    expect(fake.transformers.env.cacheDir).toBe(
+      path.resolve(storageDir, "models")
+    );
+  });
+
+  it("only logs download progress for a single file", async () => {
+    const fake = fakeTransformers(384);
+    loadWith(fake);
+    process.env.EMBEDDING_MODEL_PREF = "Xenova/nomic-embed-text-v1";
+
+    await new NativeEmbedder().embedderClient();
+
+    const { progress_callback } = fake.transformers.pipeline.mock.calls[0][2];
+    console.log.mockClear();
+    progress_callback({ status: "progress_total", progress: 10 });
+    expect(console.log).not.toHaveBeenCalled();
+    progress_callback({ status: "progress", file: "model.onnx", progress: 10 });
+    expect(console.log).toHaveBeenCalledTimes(1);
+  });
+});
