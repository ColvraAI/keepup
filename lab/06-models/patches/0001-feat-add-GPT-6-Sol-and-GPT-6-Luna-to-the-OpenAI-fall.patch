-   * @returns {number}
+   * @returns {number|undefined}
    */
   #temperature(modelName, temperature) {
+    // GPT-6 models don't support temperature unless reasoning effort is none,
+    // and we never set an effort, so it's left out of the request.
+    if (modelName.startsWith("gpt-6")) return undefined;
+
     // For models that don't support temperature
     // OpenAI accepts temperature 1
     const NO_TEMP_MODELS = ["o", "gpt-5"];
