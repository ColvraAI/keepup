+++ b/server/__tests__/utils/AiProviders/openAi/index.test.js
@@ -0,0 +1,56 @@
+/* eslint-env jest */
+const mockCreate = jest.fn();
+jest.mock("openai", () => ({
+  OpenAI: jest.fn(() => ({ responses: { create: mockCreate } })),
+}));
+
+const { OpenAiLLM } = require("../../../../utils/AiProviders/openAi");
+
+const MESSAGES = [{ role: "user", content: "hello" }];
+const EMBEDDER = {};
+
+// A property set to undefined is dropped when the request is serialized.
+function sentBody() {
+  return JSON.parse(JSON.stringify(mockCreate.mock.calls[0][0]));
+}
+
+describe("OpenAiLLM temperature", () => {
+  const ORIGINAL_KEY = process.env.OPEN_AI_KEY;
+
+  beforeEach(() => {
+    process.env.OPEN_AI_KEY = "test-key";
+    mockCreate.mockReset();
+    mockCreate.mockResolvedValue({ output_text: "hi", usage: {} });
+  });
+
+  afterAll(() => {
+    if (ORIGINAL_KEY === undefined) delete process.env.OPEN_AI_KEY;
+    else process.env.OPEN_AI_KEY = ORIGINAL_KEY;
+  });
+
+  describe.each(["gpt-6-sol", "gpt-6-luna"])("%s", (model) => {
+    it("leaves temperature out of a chat request", async () => {
+      const llm = new OpenAiLLM(EMBEDDER, model);
+      await llm.getChatCompletion(MESSAGES, { temperature: 0.7 });
+      expect(sentBody().model).toBe(model);
+      expect(sentBody()).not.toHaveProperty("temperature");
+    });
+
+    it("leaves temperature out of a streaming request", async () => {
+      const llm = new OpenAiLLM(EMBEDDER, model);
+      await llm.streamGetChatCompletion(MESSAGES, { temperature: 0.7 });
+      expect(sentBody().model).toBe(model);
+      expect(sentBody()).not.toHaveProperty("temperature");
+    });
+  });
+
+  it.each([
+    ["gpt-4o", 0.7],
+    ["gpt-5-mini", 1],
+    ["o3-mini", 1],
+  ])("keeps what %s already sends", async (model, expected) => {
+    const llm = new OpenAiLLM(EMBEDDER, model);
+    await llm.getChatCompletion(MESSAGES, { temperature: 0.7 });
+    expect(sentBody().temperature).toBe(expected);
+  });
+});
diff --git a/server/__tests__/utils/helpers/customModels.test.js b/server/__tests__/utils/helpers/customModels.test.js
new file mode 100644
index 00000000..2cf057b2
--- /dev/null
+++ b/server/__tests__/utils/helpers/customModels.test.js
@@ -0,0 +1,37 @@
+/* eslint-env jest */
+const mockList = jest.fn();
+jest.mock("openai", () => ({
+  OpenAI: jest.fn(() => ({ models: { list: mockList } })),
+}));
+
+const { getCustomModels } = require("../../../utils/helpers/customModels");
+
+describe("OpenAI fallback model list", () => {
+  const ORIGINAL_KEY = process.env.OPEN_AI_KEY;
+  let models;
+
+  beforeAll(async () => {
+    jest.spyOn(console, "error").mockImplementation(() => {});
+    mockList.mockRejectedValue(new Error("Connection error."));
+    ({ models } = await getCustomModels("openai", "test-key"));
+  });
+
+  afterAll(() => {
+    console.error.mockRestore();
+    if (ORIGINAL_KEY === undefined) delete process.env.OPEN_AI_KEY;
+    else process.env.OPEN_AI_KEY = ORIGINAL_KEY;
+  });
+
+  it("offers the new models when the list call fails", () => {
+    expect(mockList).toHaveBeenCalled();
+    expect(models.map((model) => model.id)).toEqual(
+      expect.arrayContaining(["gpt-6-sol", "gpt-6-luna"])
+    );
+  });
+
+  it("has no duplicate ids", () => {
+    const ids = models.map((model) => model.id);
+    expect(ids.length).toBeGreaterThan(0);
+    expect(new Set(ids).size).toBe(ids.length);
+  });
+});
