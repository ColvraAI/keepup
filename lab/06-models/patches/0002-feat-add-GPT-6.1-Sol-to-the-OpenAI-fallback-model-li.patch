 server/__tests__/utils/AiProviders/openAi/index.test.js | 2 +-
 server/__tests__/utils/helpers/customModels.test.js     | 2 +-
 server/utils/helpers/customModels.js                    | 8 ++++++++
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/server/__tests__/utils/AiProviders/openAi/index.test.js b/server/__tests__/utils/AiProviders/openAi/index.test.js
index 1cdee2f6..1a35cda2 100644
