+/* eslint-env jest */
+// gpt-4.1-nano shuts down on 23 Oct 2026, and OpenAI names gpt-5.6-luna as its
+// substitute: https://developers.openai.com/api/docs/deprecations
+// Each place that falls back to a default has to use the substitute when
+// nothing is set, and has to leave alone whatever a person did set.
+process.env.STORAGE_DIR = require("os").tmpdir();
+
+const mockAibitatConfigs = [];
+jest.mock("../../../../utils/prisma", () => ({}));
+jest.mock("../../../../models/workspaceChats", () => ({
+  WorkspaceChats: { where: jest.fn().mockResolvedValue([]) },
+}));
+jest.mock("../../../../utils/agents/aibitat/plugins", () => ({}));
+jest.mock("../../../../utils/agents/defaults", () => ({
+  USER_AGENT: { name: "user" },
+  WORKSPACE_AGENT: { name: "workspace" },
+  resolveAgentSkill: jest.fn(),
+}));
+jest.mock("../../../../utils/agents/imported", () => jest.fn());
+jest.mock("../../../../utils/agentFlows", () => ({ AgentFlows: {} }));
+jest.mock("../../../../utils/MCP", () => jest.fn());
+jest.mock("../../../../utils/agents/aibitat", () =>
+  jest.fn(function FakeAibitat(config) {
+    mockAibitatConfigs.push(config);
+    throw new Error("stop once the config is known");
+  })
+);
+
+const { OpenAiLLM } = require("../../../../utils/AiProviders/openAi");
+const { SystemSettings } = require("../../../../models/systemSettings");
+const OpenAIProvider = require("../../../../utils/agents/aibitat/providers/openai");
+const GenericOpenAiProvider = require("../../../../utils/agents/aibitat/providers/genericOpenAi");
+const { AgentHandler } = require("../../../../utils/agents");
+const { EphemeralAgentHandler } = require("../../../../utils/agents/ephemeral");
+
+const DEFAULT_MODEL = "gpt-5.6-luna";
+const CHOSEN_IN_ENV = "model-from-env";
+const CHOSEN_IN_WORKSPACE = "model-from-workspace";
+const EMBEDDER = {};
+
+async function modelGivenToAibitat(handler) {
+  mockAibitatConfigs.length = 0;
+  await expect(handler.createAIbitat()).rejects.toThrow("stop once");
+  return mockAibitatConfigs[0].model;
+}
+
+function agentHandler(model) {
+  const handler = new AgentHandler({ uuid: "test" });
+  handler.invocation = { workspace_id: 1 };
+  handler.provider = "openai";
+  handler.model = model;
+  return handler;
+}
+
+function ephemeralHandler(model) {
+  const handler = new EphemeralAgentHandler({ uuid: "test", prompt: "hi" });
+  handler.provider = "openai";
+  handler.model = model;
+  return handler;
+}
+
+describe("the default OpenAI model", () => {
+  const ORIGINAL_ENV = process.env;
+
+  beforeEach(() => {
+    process.env = { ...ORIGINAL_ENV, OPEN_AI_KEY: "test-key" };
+    delete process.env.OPEN_MODEL_PREF;
+  });
+
+  afterAll(() => {
+    process.env = ORIGINAL_ENV;
+  });
+
+  describe("OpenAiLLM, which chats use", () => {
+    it("uses the substitute when no model is set", () => {
+      expect(new OpenAiLLM(EMBEDDER).model).toBe(DEFAULT_MODEL);
+    });
+
+    it("sends the substitute, with the temperature the provider allows it", async () => {
+      const llm = new OpenAiLLM(EMBEDDER);
+      const create = jest.fn().mockResolvedValue({ output_text: "hi" });
+      llm.openai = { responses: { create } };
+      await llm.getChatCompletion([], { temperature: 0.7 });
+      expect(create.mock.calls[0][0].model).toBe(DEFAULT_MODEL);
+      expect(create.mock.calls[0][0].temperature).toBe(1);
+    });
+
+    it("keeps OPEN_MODEL_PREF when it is set", () => {
+      process.env.OPEN_MODEL_PREF = CHOSEN_IN_ENV;
+      expect(new OpenAiLLM(EMBEDDER).model).toBe(CHOSEN_IN_ENV);
+    });
+
+    it("keeps a workspace's model over OPEN_MODEL_PREF", () => {
+      process.env.OPEN_MODEL_PREF = CHOSEN_IN_ENV;
+      expect(new OpenAiLLM(EMBEDDER, CHOSEN_IN_WORKSPACE).model).toBe(
+        CHOSEN_IN_WORKSPACE
+      );
+    });
+  });
+
+  describe("SystemSettings, which the settings screen reads", () => {
+    it("reports the substitute when no model is set", () => {
+      expect(SystemSettings.llmPreferenceKeys().OpenAiModelPref).toBe(
+        DEFAULT_MODEL
+      );
+    });
+
+    it("reports OPEN_MODEL_PREF when it is set", () => {
+      process.env.OPEN_MODEL_PREF = CHOSEN_IN_ENV;
+      expect(SystemSettings.llmPreferenceKeys().OpenAiModelPref).toBe(
+        CHOSEN_IN_ENV
+      );
+    });
+  });
+
+  describe("the agent providers", () => {
+    it.each([
+      ["OpenAIProvider", OpenAIProvider],
+      ["GenericOpenAiProvider", GenericOpenAiProvider],
+    ])("%s uses the substitute unless given a model", (_name, Provider) => {
+      expect(new Provider({}).model).toBe(DEFAULT_MODEL);
+      expect(new Provider({ model: CHOSEN_IN_WORKSPACE }).model).toBe(
+        CHOSEN_IN_WORKSPACE
+      );
+    });
+  });
+
+  describe("AgentHandler.providerDefault", () => {
+    it("uses the substitute when no model is set", () => {
+      expect(agentHandler(null).providerDefault("openai")).toBe(DEFAULT_MODEL);
+    });
+
+    it("keeps OPEN_MODEL_PREF when it is set", () => {
+      process.env.OPEN_MODEL_PREF = CHOSEN_IN_ENV;
+      expect(agentHandler(null).providerDefault("openai")).toBe(CHOSEN_IN_ENV);
+    });
+  });
+
+  describe.each([
+    ["AgentHandler", agentHandler],
+    ["EphemeralAgentHandler", ephemeralHandler],
+  ])("%s.createAIbitat", (_name, build) => {
+    it("uses the substitute when the handler has no model", async () => {
+      expect(await modelGivenToAibitat(build(null))).toBe(DEFAULT_MODEL);
+    });
+
+    it("keeps the handler's model when it has one", async () => {
+      expect(await modelGivenToAibitat(build(CHOSEN_IN_WORKSPACE))).toBe(
+        CHOSEN_IN_WORKSPACE
+      );
+    });
+  });
+});
