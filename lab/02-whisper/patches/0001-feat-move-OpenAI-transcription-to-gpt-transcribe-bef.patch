@@ -0,0 +1,235 @@
+/* eslint-env jest, node */
+const fs = require("fs");
+const { NotFoundError, BadRequestError, AuthenticationError } =
+  jest.requireActual("openai");
+
+const mockCreate = jest.fn();
+jest.mock("openai", () => ({
+  OpenAI: jest.fn(() => ({
+    audio: { transcriptions: { create: mockCreate } },
+  })),
+}));
+
+const {
+  OpenAiWhisper,
+} = require("../../../utils/WhisperProviders/OpenAiWhisper");
+
+const fakeStream = { fake: "stream" };
+const options = { openAiKey: "sk-test" };
+const notFound = (model) =>
+  new NotFoundError(
+    404,
+    {
+      message: `The model \`${model}\` does not exist or you do not have access to it.`,
+      type: "invalid_request_error",
+      param: null,
+      code: "model_not_found",
+    },
+    undefined,
+    {}
+  );
+
+describe("OpenAiWhisper", () => {
+  beforeEach(() => {
+    mockCreate.mockReset();
+    mockCreate.mockResolvedValue({ text: "hello" });
+    jest.spyOn(fs, "createReadStream").mockReturnValue(fakeStream);
+    jest.spyOn(console, "log").mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    jest.restoreAllMocks();
+  });
+
+  it("requires an API key", () => {
+    expect(() => new OpenAiWhisper({ options: {} })).toThrow(
+      "No OpenAI API key was set."
+    );
+  });
+
+  it("defaults to gpt-transcribe when no model is set", async () => {
+    const whisper = new OpenAiWhisper({ options });
+    await whisper.processFile("/tmp/audio.mp3");
+
+    expect(fs.createReadStream).toHaveBeenCalledWith("/tmp/audio.mp3");
+    expect(mockCreate).toHaveBeenCalledWith({
+      file: fakeStream,
+      model: "gpt-transcribe",
+      temperature: 0,
+    });
+  });
+
+  it("sends the configured model", async () => {
+    const whisper = new OpenAiWhisper({
+      options: { ...options, WhisperOpenAiModel: "gpt-next-transcribe" },
+    });
+    await whisper.processFile("/tmp/audio.mp3");
+
+    expect(mockCreate.mock.calls[0][0].model).toBe("gpt-next-transcribe");
+  });
+
+  it("can roll back to whisper-1 through the setting", async () => {
+    const whisper = new OpenAiWhisper({
+      options: { ...options, WhisperOpenAiModel: "whisper-1" },
+    });
+    const result = await whisper.processFile("/tmp/audio.mp3");
+
+    expect(mockCreate.mock.calls[0][0].model).toBe("whisper-1");
+    expect(result).toEqual({ content: "hello", error: null });
+  });
+
+  it("returns only the text from gpt-transcribe's response", async () => {
+    mockCreate.mockResolvedValue({
+      text: "Bonjour, pouvez-vous m'entendre ?",
+      languages: [{ code: "fr" }],
+      usage: { type: "duration", seconds: 3 },
+    });
+    const whisper = new OpenAiWhisper({ options });
+
+    expect(await whisper.processFile("/tmp/audio.mp3")).toEqual({
+      content: "Bonjour, pouvez-vous m'entendre ?",
+      error: null,
+    });
+  });
+
+  it("reports an empty response in the same shape", async () => {
+    mockCreate.mockResolvedValue(null);
+    const whisper = new OpenAiWhisper({ options });
+
+    expect(await whisper.processFile("/tmp/audio.mp3")).toEqual({
+      content: "",
+      error: "No content was able to be transcribed.",
+    });
+  });
+
+  it("names the model and the setting when OpenAI does not know the model", async () => {
+    mockCreate.mockRejectedValue(notFound("gpt-typo"));
+    const whisper = new OpenAiWhisper({
+      options: { ...options, WhisperOpenAiModel: "gpt-typo" },
+    });
+    const { content, error } = await whisper.processFile("/tmp/audio.mp3");
+
+    expect(content).toBe("");
+    expect(error).toContain('"gpt-typo"');
+    expect(error).toContain("WHISPER_OPEN_AI_MODEL");
+    expect(error).toContain("gpt-transcribe");
+    expect(error).toContain("does not exist or you do not have access to it");
+  });
+
+  it("gives the same clear error when the model is refused with a bad request", async () => {
+    mockCreate.mockRejectedValue(
+      new BadRequestError(
+        400,
+        { message: "invalid model ID", type: "invalid_request_error" },
+        undefined,
+        {}
+      )
+    );
+    const whisper = new OpenAiWhisper({
+      options: { ...options, WhisperOpenAiModel: "gpt-4o" },
+    });
+    const { error } = await whisper.processFile("/tmp/audio.mp3");
+
+    expect(error).toContain('"gpt-4o"');
+    expect(error).toContain("WHISPER_OPEN_AI_MODEL");
+  });
+
+  it("gives the same clear error when OpenAI points at the model parameter", async () => {
+    mockCreate.mockRejectedValue(
+      new BadRequestError(
+        400,
+        { message: "Unsupported value.", param: "model" },
+        undefined,
+        {}
+      )
+    );
+    const whisper = new OpenAiWhisper({
+      options: { ...options, WhisperOpenAiModel: "gpt-4o" },
+    });
+    const { error } = await whisper.processFile("/tmp/audio.mp3");
+
+    expect(error).toContain('"gpt-4o"');
+    expect(error).toContain("WHISPER_OPEN_AI_MODEL");
+  });
+
+  // These messages are written for the test. They are the shapes that must not
+  // send someone to the model setting, not text documented by OpenAI.
+  it.each([
+    [400, "Audio duration 1500 seconds is longer than the maximum for this model"],
+    [400, "Temperature is not supported with this model"],
+    [400, "This model does not support the format you provided"],
+  ])("does not blame the model for a %i about the audio or a parameter: %s", async (status, message) => {
+    mockCreate.mockRejectedValue(
+      new BadRequestError(status, { message }, undefined, {})
+    );
+    const whisper = new OpenAiWhisper({ options });
+
+    expect(await whisper.processFile("/tmp/audio.mp3")).toEqual({
+      content: "",
+      error: `${status} ${message}`,
+    });
+  });
+
+  it("does not blame the model when OpenAI names another parameter", async () => {
+    mockCreate.mockRejectedValue(
+      new BadRequestError(
+        400,
+        { message: "Invalid model settings for this file", param: "file" },
+        undefined,
+        {}
+      )
+    );
+    const whisper = new OpenAiWhisper({ options });
+
+    expect(await whisper.processFile("/tmp/audio.mp3")).toEqual({
+      content: "",
+      error: "400 Invalid model settings for this file",
+    });
+  });
+
+  it("does not blame the model for a 404 that does not mention it", async () => {
+    mockCreate.mockRejectedValue(
+      new NotFoundError(404, { message: "Not found" }, undefined, {})
+    );
+    const whisper = new OpenAiWhisper({ options });
+
+    expect(await whisper.processFile("/tmp/audio.mp3")).toEqual({
+      content: "",
+      error: "404 Not found",
+    });
+  });
+
+  it("leaves errors that are not about the model as they were", async () => {
+    mockCreate.mockRejectedValue(
+      new AuthenticationError(
+        401,
+        { message: "Incorrect API key provided." },
+        undefined,
+        {}
+      )
+    );
+    const whisper = new OpenAiWhisper({ options });
+
+    expect(await whisper.processFile("/tmp/audio.mp3")).toEqual({
+      content: "",
+      error: "401 Incorrect API key provided.",
+    });
+  });
+
+  it("does not blame the model for a bad request about something else", async () => {
+    mockCreate.mockRejectedValue(
+      new BadRequestError(
+        400,
+        { message: "Audio file might be corrupted or unsupported" },
+        undefined,
+        {}
+      )
+    );
+    const whisper = new OpenAiWhisper({ options });
+
+    expect(await whisper.processFile("/tmp/audio.mp3")).toEqual({
+      content: "",
+      error: "400 Audio file might be corrupted or unsupported",
+    });
+  });
+});
