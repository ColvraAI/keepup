@@ -0,0 +1,58 @@
+/* eslint-env jest, node */
+jest.mock("../../../utils/comKey", () => ({
+  CommunicationKey: jest.fn(() => ({
+    sign: () => "signed",
+    encrypt: () => "encrypted",
+  })),
+}));
+jest.mock("../../../utils/EncryptionManager", () => ({
+  EncryptionManager: jest.fn(() => ({ xPayload: "payload" })),
+}));
+
+const { updateENV } = require("../../../utils/helpers/updateENV");
+const { CollectorApi } = require("../../../utils/collectorApi");
+
+describe("WhisperOpenAiModel setting", () => {
+  const ORIGINAL_ENV = process.env;
+  const ORIGINAL_FETCH = global.fetch;
+
+  const optionsSentToCollector = async () => {
+    await new CollectorApi().processDocument("audio.mp3");
+    return JSON.parse(global.fetch.mock.calls[0][1].body).options;
+  };
+
+  beforeEach(() => {
+    process.env = { ...ORIGINAL_ENV };
+    delete process.env.WHISPER_OPEN_AI_MODEL;
+    global.fetch = jest.fn(async () => ({
+      ok: true,
+      json: async () => ({ success: true }),
+    }));
+  });
+
+  afterAll(() => {
+    process.env = ORIGINAL_ENV;
+    global.fetch = ORIGINAL_FETCH;
+  });
+
+  test("a saved model reaches the collector", async () => {
+    const { error } = await updateENV({ WhisperOpenAiModel: "whisper-1" });
+
+    expect(error).toBe(false);
+    expect(process.env.WHISPER_OPEN_AI_MODEL).toBe("whisper-1");
+    expect((await optionsSentToCollector()).WhisperOpenAiModel).toBe(
+      "whisper-1"
+    );
+  });
+
+  test("an empty model is refused", async () => {
+    const { error } = await updateENV({ WhisperOpenAiModel: "" });
+
+    expect(error).toBe("Value cannot be empty");
+    expect(process.env.WHISPER_OPEN_AI_MODEL).toBeUndefined();
+  });
+
+  test("with nothing saved, the collector falls back to its default", async () => {
+    expect((await optionsSentToCollector()).WhisperOpenAiModel).toBeNull();
+  });
+});
