@@ -17,6 +19,34 @@ class OpenAiWhisper {
     console.log(`\x1b[32m[OpenAiWhisper]\x1b[0m ${text}`, ...args);
   }
 
+  /**
+   * Whether OpenAI's error is about the model ID itself. An error about the audio
+   * or another parameter can mention the model too, and must not point at the setting.
+   * @param {Error} error - The error thrown by the OpenAI client
+   * @returns {boolean}
+   */
+  #modelRefused(error) {
+    if (error.code === "model_not_found" || error.param === "model")
+      return true;
+    if (error.param) return false;
+    return (
+      [400, 404].includes(error.status) &&
+      /invalid model|\bmodel\b.*(does not exist|not found)/i.test(error.message)
+    );
+  }
+
+  /**
+   * Only OpenAI knows which models a key can use, so we keep no list of them here.
+   * When it refuses the configured model, name the model and the setting to change.
+   * @param {Error} error - The error thrown by the OpenAI client
+   * @returns {string} - The message to show the user
+   */
+  #errorMessage(error) {
+    if (!this.#modelRefused(error)) return error.message;
+
+    return `OpenAI refused the transcription model "${this.model}". Check the Transcription Model setting (WHISPER_OPEN_AI_MODEL); the default is ${DEFAULT_MODEL}. OpenAI said: ${error.message}`;
+  }
+
   async processFile(fullFilePath) {
     return await this.openai.audio.transcriptions
       .create({
@@ -39,7 +69,7 @@ class OpenAiWhisper {
           `Could not get any response from openai whisper`,
           error.message
         );
-        return { content: "", error: error.message };
+        return { content: "", error: this.#errorMessage(error) };
       });
   }
 }
